# Copy to .env and adjust for your local environment.

# Backend HTTP server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Supabase configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated Supabase user IDs allowed to use the staff queue.
# Accounts with app_metadata.appointment_staff = true or
# app_metadata.role = "appointment_staff" are also allowed.
APPOINTMENT_STAFF_USER_IDS=
# INVENTORY_STAFF_USER_IDS grants full inventory access (all hospitals) to
# listed Supabase user IDs. For hospital-scoped staff, leave this unset and use
# trusted app_metadata instead:
#   app_metadata.inventory_staff = true
#   app_metadata.inventory_hospital_ids = [1, 2]
# Optional metadata aliases: inventory_role/inventory-admin,
# allowed_hospital_ids, inventory_all_hospitals.
INVENTORY_STAFF_USER_IDS=

# Private Python ML service used for rolling-origin model comparison.
ML_SERVICE_URL=http://127.0.0.1:8000

# ── External Notification Providers ─────────────────────────────────────
# When unset, in-memory mock providers log sends for local dev & automated tests.

# Instant Mobile Alerts (Recommended for Hackathons - 100% Free, 0 INR, No Card):
# Telegram Bot API delivers instant mobile push alerts with interactive buttons directly to iOS/Android phones.
# 1. Open Telegram on your phone and search for @BotFather
# 2. Send: /newbot -> choose a name (e.g. "Pulse AI Alerts") and username (e.g. "PulseAiAlertsBot")
# 3. Copy the HTTP API token into TELEGRAM_BOT_TOKEN
# 4. Search for @userinfobot on Telegram and tap Start to get your numeric user Id (e.g. 123456789)
# 5. Set TELEGRAM_CHAT_ID to your user Id, or send /start to your bot!
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email: Resend (https://resend.com — free 3,000 emails/month)
# 1. Sign up free at https://resend.com
# 2. Go to API Keys -> Create API Key
# 3. For dev: keep onboarding@resend.dev (sends to the email you signed up with)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pulse AI <onboarding@resend.dev>

# SMS / WhatsApp: Twilio (https://www.twilio.com — $15.50 free trial on signup, no credit card)
# 1. Sign up free at https://www.twilio.com
# 2. Verify your mobile number
# 3. For free WhatsApp alerts without DLT:
#    Use Twilio Sandbox -> set TWILIO_FROM_NUMBER=whatsapp:+14155238886
#    Or for SMS: set TWILIO_FROM_NUMBER=+1XXXXXXXXXX (your Twilio trial number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMS: Fast2SMS (https://www.fast2sms.com — requires 100 INR recharge to unlock Dev API)
FAST2SMS_API_KEY=

# Public application URL used for links inside email / push notifications
APP_URL=https://pulse-ai-ruby.vercel.app

# SMS Alternative (Exotel - India Telecom / TRAI DLT approved)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_SENDER_ID=PULSEH

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pulseai.health
