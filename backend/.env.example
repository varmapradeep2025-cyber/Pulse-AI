# Copy to .env and adjust for your local environment.

# Backend HTTP server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Supabase configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated Supabase user IDs allowed to use the staff queue.
# Accounts with app_metadata.appointment_staff = true or
# app_metadata.role = "appointment_staff" are also allowed.
APPOINTMENT_STAFF_USER_IDS=
# INVENTORY_STAFF_USER_IDS grants full inventory access to listed accounts.
# For hospital-scoped access, set app_metadata.inventory_staff = true and
# app_metadata.inventory_hospital_ids = [1, 2] on the Supabase user.
INVENTORY_STAFF_USER_IDS=

# URL of the ML service (reserved for a later phase - not used yet).
ML_SERVICE_URL=http://localhost:8000